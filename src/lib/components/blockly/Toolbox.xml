	</category>
	<category name="Flags" categorystyle="flags_category">
		<block type="flag_generate_indices"></block>
		<block type="flag_global"></block>
		<block type="flag_case_insensitive"></block>
		<block type="flag_multiline"></block>
		<block type="flag_wildcard_all"></block>
		<block type="flag_unicode"></block>
		<block type="flag_modern_unicode"></block>
		<block type="flag_sticky"></block>
	</category>
</xml>