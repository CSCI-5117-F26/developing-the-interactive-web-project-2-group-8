<xml id="toolbox" style="display: none">
	<category name="Atoms" categorystyle="atom_category">
		<block type="atom_literal"></block>
		<block type="atom_capturing_group"></block>
		<block type="atom_named_capturing_group"></block>
		<block type="atom_non_capturing_group"></block>
		<block type="atom_backreference"></block>
		<block type="atom_named_backreference"></block>
		<block type="quantifier_range"></block>
	</category>
	<category name="Assertions" categorystyle="assertion_category">
		<block type="assertion_start"></block>
		<block type="assertion_end"></block>
		<block type="assertion_lookahead"></block>
		<block type="assertion_lookbehind"></block>
